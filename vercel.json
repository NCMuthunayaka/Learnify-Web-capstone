{
  "buildCommand": "cd learnify-frontend && npm run build",
  "outputDirectory": "learnify-frontend/dist",
  "installCommand": "cd learnify-frontend && npm install",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "unsafe-none"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
